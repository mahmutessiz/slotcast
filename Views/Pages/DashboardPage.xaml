<Page x:Class="SlotCast.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Home" ScrollViewer.CanContentScroll="False" Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AnimeStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="PosterInfo">
                <StackPanel MaxWidth="320">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding OverviewText}" TextWrapping="Wrap" MaxHeight="150" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="AnimeCard">
                <Border Width="174" Margin="0,0,16,16" Style="{StaticResource Panel}" Padding="0" VerticalAlignment="Top">
                    <StackPanel>
                        <Button Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000"
                                Command="{Binding DataContext.ViewModel.OpenCardDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                            <Button.ToolTip><ToolTip Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource PosterInfo}" /></Button.ToolTip>
                            <Grid Height="232" Width="172" Background="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="No poster" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                                <Image Source="{Binding PosterUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Button>
                        <StackPanel Margin="10">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="40" Margin="0,0,0,10" ToolTip="{Binding Title}" />
                            <DockPanel LastChildFill="True">
                                <ui:Button DockPanel.Dock="Right" Content="Details" ToolTip="View anime details" Margin="4,0,0,0" Padding="8,4"
                                           Command="{Binding DataContext.ViewModel.OpenCardDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                <ui:Button ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding ActionLabel}" Width="32" Height="32" MinWidth="0" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#567AEA" Foreground="White" Padding="0"
                                           Command="{Binding DataContext.ViewModel.AddFromHomeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Add16" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ui:Button>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="PosterGrid"><WrapPanel Orientation="Horizontal" ItemWidth="190" /></ItemsPanelTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid Margin="0,12,0,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding ViewModel.ErrorMessage}" Style="{StaticResource ErrorText}" />
            <TextBlock Text="{Binding ViewModel.Workspace.ErrorMessage}" Style="{StaticResource ErrorText}" />
            <TextBlock Text="{Binding ViewModel.ActionMessage}" Style="{StaticResource ErrorText}" Foreground="#8DADFF" />
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolVisibility}}" />
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding ViewModel.Workspace.IsBusy, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
        <Grid Grid.Row="2" IsEnabled="{Binding ViewModel.IsIdle}">
            <ScrollViewer x:Name="HomeScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" IsEnabled="{Binding ViewModel.Workspace.IsIdle}">
                <StackPanel Margin="0,0,12,0">
                    <DockPanel Margin="0,0,0,16">
                        <ui:Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding ViewModel.RefreshHomeCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Airing today" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ViewModel.AiringTodayStatus}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ViewModel.AiringToday}" ItemTemplate="{StaticResource AnimeCard}" ItemsPanel="{StaticResource PosterGrid}" />
                    <TextBlock Text="{Binding ViewModel.CurrentSeasonLabel}" FontSize="24" FontWeight="SemiBold" Margin="0,28,0,4" />
                    <TextBlock Text="{Binding ViewModel.SeasonStatus}" Style="{StaticResource Secondary}" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding ViewModel.SeasonAnime}" ItemTemplate="{StaticResource AnimeCard}" ItemsPanel="{StaticResource PosterGrid}" />
                    <ui:Button Content="Load more seasonal anime" Command="{Binding ViewModel.LoadMoreSeasonCommand}" Margin="0,4,0,8" Visibility="{Binding ViewModel.HasMoreSeasonAnime, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Text="New releases" FontSize="24" FontWeight="SemiBold" Margin="0,28,0,4" />
                    <TextBlock Text="Latest TV anime premieres" Style="{StaticResource Secondary}" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding ViewModel.NewReleases}" ItemTemplate="{StaticResource AnimeCard}" ItemsPanel="{StaticResource PosterGrid}" />
                    <TextBlock Text="Simkl Trending Today" FontSize="24" FontWeight="SemiBold" Margin="0,28,0,4" />
                    <TextBlock Text="Most watched TV anime today. Find a title on AnimeSchedule to add the right season." Style="{StaticResource Secondary}" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Trending}" ItemTemplate="{StaticResource AnimeCard}" ItemsPanel="{StaticResource PosterGrid}" />
                    <TextBlock Text="Coming soon" FontSize="24" FontWeight="SemiBold" Margin="0,28,0,4" />
                    <TextBlock Text="Upcoming TV anime premieres" Style="{StaticResource Secondary}" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Upcoming}" ItemTemplate="{StaticResource AnimeCard}" ItemsPanel="{StaticResource PosterGrid}" />
                    <TextBlock Text="{Binding ViewModel.FeedStatus}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,24,0,0" />
                    <TextBlock Text="Anime and schedules from AnimeSchedule.net · Trending from SIMKL" Style="{StaticResource Secondary}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
