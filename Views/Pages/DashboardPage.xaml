<Page
  x:Class="episodeTracker.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:episodeTracker.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="DashboardPage"
  d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid VerticalAlignment="Top">
        <StackPanel>
            <ui:Button
        Content="Load show"
        Command="{Binding ViewModel.LoadShowCommand}"
        Appearance="Primary" />

            <TextBlock
        Margin="0,12,0,0"
        Text="{Binding ViewModel.ShowTitle}" />

            <TextBlock
        Margin="0,8,0,0"
        Text="{Binding ViewModel.ErrorMessage}"
        TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
