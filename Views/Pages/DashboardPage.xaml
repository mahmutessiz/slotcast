<Page
  x:Class="episodeTracker.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:episodeTracker.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="DashboardPage"
  d:DataContext="{d:DesignInstance local:DashboardPage,
                                     IsDesignTimeCreatable=False}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d"
>
  <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
        <ui:Button
            Content="Load show"
            Command="{Binding ViewModel.LoadShowCommand}"
            Appearance="Primary" />

        <TextBlock
            Margin="0,12,0,0"
            Text="{Binding ViewModel.ShowTitle}" />

        <TextBlock
            Margin="0,12,0,0"
            TextWrapping="Wrap"
            Text="{Binding ViewModel.ShowYear}" />

        <TextBlock
            Margin="0,12,0,0"
            Width="600"
            TextWrapping="Wrap"
            HorizontalAlignment="Left"
            Text="{Binding ViewModel.ShowOverview}" />

        <TextBlock
            Margin="0,8,0,0"
            Text="{Binding ViewModel.ErrorMessage}"
            TextWrapping="Wrap" />

        <TextBlock Margin="0,24,0,12"
                   FontSize="20" FontWeight="SemiBold"
                   Text="Simkl Trending Anime — Today" />
        <ui:Button Content="Load trending anime"
                   Command="{Binding ViewModel.LoadTrendingAnimesCommand}"
                   Appearance="Primary" Margin="0,0,0,12" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{Binding ViewModel.TrendingAnimes}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Anime" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Hyperlink
                                        Command="{Binding DataContext.ViewModel.OpenSimklCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding SimklUrl}">
                                        <Run Text="{Binding Title}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Year" Width="65"
                                    DisplayMemberBinding="{Binding Year}" />
                    <GridViewColumn Header="Watched today" Width="110"
                                    DisplayMemberBinding="{Binding Watched}" />
                    <GridViewColumn Header="SIMKL rank" Width="90"
                                    DisplayMemberBinding="{Binding Rank}" />
                    <GridViewColumn Header="SIMKL rating" Width="95"
                                    DisplayMemberBinding="{Binding Ratings.Simkl.Rating}" />
                    <GridViewColumn Header="MAL rating" Width="90"
                                    DisplayMemberBinding="{Binding Ratings.Mal.Rating}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
