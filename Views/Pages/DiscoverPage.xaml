<Page x:Class="episodeTracker.Views.Pages.DiscoverPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" ScrollViewer.CanContentScroll="False" Title="Discover" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <ResourceDictionary Source="AnimeStyles.xaml" />
  </Page.Resources>
  <Grid Margin="0,8,0,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding ViewModel.ErrorMessage}" Style="{StaticResource ErrorText}" />
    <StackPanel Grid.Row="1" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
      <ProgressBar IsIndeterminate="True" Height="3" />
      <TextBlock Text="{Binding ViewModel.BusyMessage}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
    </StackPanel>
    <Grid Grid.Row="2" IsEnabled="{Binding ViewModel.IsIdle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Text="{Binding ViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Find your next TV anime…" MaxLength="200" Margin="0,0,12,0">
            <ui:TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding ViewModel.SearchCommand}" />
            </ui:TextBox.InputBindings>
          </ui:TextBox>
          <ui:Button Grid.Column="1" Content="Search" Appearance="Primary" Background="#567AEA" Foreground="White" Command="{Binding ViewModel.SearchCommand}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding ViewModel.SearchSummary}" Style="{StaticResource Secondary}" Margin="0,12" />
        <ListBox Grid.Row="2" ItemsSource="{Binding ViewModel.SearchResults}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="8,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="4" Background="{DynamicResource CardStrokeColorDefaultBrush}" Width="50" Height="72" VerticalAlignment="Top">
                    <Image Source="{Binding PosterUrl}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <ui:Button Content="+" ToolTip="Add to library" Width="36" Appearance="Primary" Background="#567AEA" Foreground="White" Command="{Binding DataContext.ViewModel.AddAnimeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                  <ui:Button Content="Details" Margin="0,6,0,0" Command="{Binding DataContext.ViewModel.OpenAnimeDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
          <ui:Button Content="Previous" Command="{Binding ViewModel.PreviousSearchCommand}" />
          <ui:Button Content="Next" Command="{Binding ViewModel.NextSearchCommand}" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0">Data from <Hyperlink Command="{Binding ViewModel.OpenSourceCommand}">AnimeSchedule.net</Hyperlink></TextBlock>
  </Grid>
</Page>
