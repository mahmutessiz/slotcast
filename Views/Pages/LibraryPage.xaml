<Page x:Class="SlotCast.Views.Pages.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:SlotCast.Services" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" ScrollViewer.CanContentScroll="False" Title="My library" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <ResourceDictionary Source="AnimeStyles.xaml" />
  </Page.Resources>
  <Grid Margin="0,8,0,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding ViewModel.ErrorMessage}" Style="{StaticResource ErrorText}" />
    <StackPanel Grid.Row="1" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
      <ProgressBar IsIndeterminate="True" Height="3" />
      <TextBlock Text="{Binding ViewModel.BusyMessage}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
    </StackPanel>
    <Grid Grid.Row="2" IsEnabled="{Binding ViewModel.IsIdle}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding ViewModel.LibrarySectionTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" />
        <ui:Button Cursor="Hand" Content="Watching" Command="{Binding ViewModel.ShowActiveLibraryCommand}" />
        <ui:Button Cursor="Hand" Content="Archive" Command="{Binding ViewModel.ShowCompletedLibraryCommand}" Margin="8,0,20,0" />
        <ui:Button Cursor="Hand" Content="Mark completed" Command="{Binding ViewModel.MarkCompletedCommand}" CommandParameter="{Binding ViewModel.SelectedAnime}" />
        <ui:Button Cursor="Hand" Content="Details" Command="{Binding ViewModel.OpenLibraryDetailsCommand}" CommandParameter="{Binding ViewModel.SelectedAnime}" Margin="8,0,0,0" />
        <ui:Button Cursor="Hand" Content="Refresh episodes" Command="{Binding ViewModel.RefreshEpisodeInformationCommand}" Margin="8,0,0,0" />
        <ui:Button Cursor="Hand" Content="Remove" Command="{Binding ViewModel.RemoveAnimeCommand}" CommandParameter="{Binding ViewModel.SelectedAnime}" Margin="8,0,0,0" />
      </WrapPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding ViewModel.VisibleLibraryItems}" SelectedItem="{Binding ViewModel.SelectedAnime}" Margin="0,0,16,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Grid.Column="0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="12,2">
                      <ContentPresenter />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="BorderBrush" Value="#648CF5" />
                  <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="#7888A0" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="72" CornerRadius="4" Background="{DynamicResource CardStrokeColorDefaultBrush}" VerticalAlignment="Top">
                  <Image services:PosterCache.Url="{Binding PosterUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding ProgressLabel}" Foreground="#648CF5" Margin="0,6,0,0" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ListBox Grid.Column="1" ItemsSource="{Binding ViewModel.EpisodeRows}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="EpisodeList">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Padding" Value="6,2" />
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#0AFFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#10FFFFFF" />
                  <Setter Property="BorderBrush" Value="#506F809C" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="6,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,5" Visibility="{Binding HasTitle, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding WatchedStatus}" Margin="0,4,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsWatched}" Value="True">
                            <Setter Property="Foreground" Value="#79C99A" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding ScheduleLabel}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,4,12,0" />
                </StackPanel>
                <ui:Button Cursor="Hand" Grid.Column="1" IsEnabled="{Binding CanMark}" Command="{Binding DataContext.ViewModel.ToggleEpisodeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
<ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Background" Value="#567AEA" /><Setter Property="Foreground" Value="White" /><Style.Triggers><DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Background" Value="#287B52" /><Setter Property="BorderBrush" Value="#8DD8AC" /></DataTrigger></Style.Triggers></Style></ui:Button.Style>
<StackPanel Orientation="Horizontal"><ui:SymbolIcon Margin="0,0,8,0"><ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon"><Setter Property="Symbol" Value="Checkmark16" /><Style.Triggers><DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Symbol" Value="ArrowUndo16" /></DataTrigger></Style.Triggers></Style></ui:SymbolIcon.Style></ui:SymbolIcon><TextBlock Text="{Binding ActionLabel}" /></StackPanel></ui:Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0">Data from <Hyperlink Command="{Binding ViewModel.OpenSourceCommand}">AnimeSchedule.net</Hyperlink> - Episode titles and Japanese air dates: Jikan / MyAnimeList</TextBlock>
  </Grid>
</Page>
