<Page x:Class="SlotCast.Views.Pages.CalendarPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:SlotCast.Services" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" ScrollViewer.CanContentScroll="False" Title="Calendar" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AnimeStyles.xaml" /></ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="EpisodePosterInfo">
        <StackPanel MaxWidth="320">
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding TimeLabel}" Foreground="#8DADFF" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{Binding EpisodeLabel}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding AiringSeasonLabel}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{Binding StateLabel}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </DataTemplate>
      <Style x:Key="PosterWatchButton" TargetType="Button">
        <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#E0202020" />
        <Setter Property="BorderBrush" Value="#B0FFFFFF" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsTracked}" Value="False"><Setter Property="Background" Value="#567AEA" /></DataTrigger>
          <DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Background" Value="#287B52" /><Setter Property="BorderBrush" Value="#8DD8AC" /></DataTrigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#8DADFF" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Page.Resources>
  <Grid Margin="0,8,0,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding ViewModel.ErrorMessage}" Style="{StaticResource ErrorText}" />
    <StackPanel Grid.Row="1" Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
      <ProgressBar IsIndeterminate="True" Height="3" />
      <TextBlock Text="{Binding ViewModel.BusyMessage}" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
    </StackPanel>
    <Grid Grid.Row="2" IsEnabled="{Binding ViewModel.IsIdle}">
      <Grid>
        <Grid Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <ui:Button Cursor="Hand" Content="‹" Command="{Binding ViewModel.PreviousWeekCommand}" ToolTip="Previous week" Margin="0,0,8,8" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ViewModel.WeekLabel}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,8" />
            <ui:Button Cursor="Hand" Content="›" Command="{Binding ViewModel.NextWeekCommand}" ToolTip="Next week" Margin="0,0,8,8" VerticalAlignment="Center" />
            <ui:Button Cursor="Hand" Content="Today" Command="{Binding ViewModel.TodayCommand}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ViewModel.CalendarScopes}" DisplayMemberPath="Label" SelectedValuePath="ShowAll" SelectedValue="{Binding ViewModel.ShowFullSchedule, Mode=TwoWay}" Width="165" Margin="0,0,8,8" ToolTip="Choose your library or the full TV-anime schedule" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ViewModel.ScheduleChoices}" SelectedItem="{Binding ViewModel.SelectedSchedule}" Width="185" ToolTip="Subtitle schedules may fall back to Japanese broadcasts; each card labels its source." Margin="0,0,8,8" VerticalAlignment="Center" />
            <ui:Button Cursor="Hand" Content="Apply" Command="{Binding ViewModel.ChangeScheduleCommand}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <ui:Button Cursor="Hand" Content="Refresh" Command="{Binding ViewModel.RefreshCommand}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <ui:Button Cursor="Hand" ToolTip="Add anime" AutomationProperties.Name="Add anime" Appearance="Primary" Background="#567AEA" Foreground="White" Width="36" Height="32" MinWidth="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ViewModel.DiscoverCommand}" Margin="0,0,8,8" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Add16" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></ui:Button>
          </WrapPanel>
          <ScrollViewer x:Name="WeekScroller" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
            <ItemsControl x:Name="WeekItems" ItemsSource="{Binding ViewModel.CalendarDays}" MinWidth="1680" Width="{Binding ViewportWidth, ElementName=WeekScroller}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7" Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,4,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Cursor="Hand" Style="{StaticResource DayButton}" Command="{Binding DataContext.ViewModel.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                      <StackPanel>
                        <TextBlock Text="{Binding Date, StringFormat={}{0:ddd}}" FontSize="11" />
                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM}}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Summary}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Margin="2,6,2,0">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Episodes}" Margin="10">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,12" Margin="0,0,0,8">
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                  <StackPanel Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding TimeLabel}" Foreground="#8DADFF" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" LineHeight="18" Margin="0,6,0,8" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding AiringSeasonLabel}" Style="{StaticResource Secondary}" FontSize="11" />
                                    <TextBlock Text="{Binding EpisodeLabel}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,5,0,0" />
                                  </StackPanel>
                                  <Border Grid.Column="1" Height="144" VerticalAlignment="Top" CornerRadius="4" Background="{DynamicResource CardStrokeColorDefaultBrush}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
                                    <Border.ToolTip><ToolTip Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ContentTemplate="{StaticResource EpisodePosterInfo}" /></Border.ToolTip>
                                    <Grid>
                                      <Button Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.ViewModel.OpenCalendarDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" AutomationProperties.Name="View anime details"><Grid><TextBlock Text="No poster" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                                      <Image services:PosterCache.Url="{Binding BannerUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                      </Grid></Button><Button Cursor="Hand" Style="{StaticResource PosterWatchButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                              ToolTip="{Binding ActionLabel}" AutomationProperties.Name="{Binding ActionLabel}" IsEnabled="{Binding CanAct}"
                                              Command="{Binding DataContext.ViewModel.ToggleCalendarEpisodeCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                          <ui:SymbolIcon.Style><Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Circle16" />
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Symbol" Value="Checkmark16" /></DataTrigger>
                                              <DataTrigger Binding="{Binding IsTracked}" Value="False"><Setter Property="Symbol" Value="Add16" /></DataTrigger>
                                            </Style.Triggers>
                                          </Style></ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                      </Button>
                                    </Grid>
                                  </Border>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="3" Text="{Binding ViewModel.SyncStatus}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,10,0,0" />
        </Grid>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="3" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0">Data from <Hyperlink Command="{Binding ViewModel.OpenSourceCommand}">AnimeSchedule.net</Hyperlink></TextBlock>
  </Grid>
</Page>
